# 构建产物
/target/

# 预编译对照件（来自 external release 包，不入库）
/release-prebuilt/

# 打包产物（scripts/package.ps1 生成，不入库）
/dist/

# 节点/客户端身份私钥，绝不入库
node_identity.key
wgp-client.key
*.key

# 运行期产物
*.log
*.jsonl
# 节点广告纪元（启动计数，与身份文件同目录；见 server.rs::next_advertise_epoch）
*.epoch

# ET bridge PoC: its own target dir and downloaded build tools (protoc)
/bridge/wgp-et-bridge/target/
/bridge/wgp-et-bridge/.tools/

# 受限沙箱/CI 里的临时目录（PROTOC&TEMP 指到仓库内时用；et-bridge README 有说明）
/.tmp/

# 本机工具产物（沙箱 ACL 诊断报告、编辑器规则），与代码无关
/.acl-report/
/.cursor/
