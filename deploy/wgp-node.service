[Unit]
Description=wgp-node (ZheYueMen P2P seed/observer/STUN/commit-forward)
After=network-online.target
Wants=network-online.target

[Service]
# 工作目录：存放 node_identity.key（身份持久化，勿删除）
WorkingDirectory=/opt/wgp-node
ExecStart=/opt/wgp-node/wgp-node 0.0.0.0:3841 3478
# 身份文件敏感性：仅本服务可读（07 §8 防身份漂移）
User=wgp
Group=wgp
Restart=on-failure
RestartSec=5
# 无状态服务：无需大内存；限一下防止异常
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target