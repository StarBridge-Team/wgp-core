#!/usr/sbin/nft -f
# wgp-node 源站流量整形（07 §7 技术级加固）
# 原则：协议本身是小包低频（正常流量远低于限速），超频即视为滥用。
flush ruleset

table inet wgp {
    # 白名单：允许的入站端口
    #   UDP：DHT 信令 11010 + STUN 观察者 3478
    #   TCP：DHT 信令兜底 3481（UDP 出站被封时的降级通道，长度前缀帧）
    set protected_udp {
        type inet_service
        elements = { 11010, 3478 }
    }
    set protected_tcp {
        type inet_service
        elements = { 3481 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # 回环与已建连接放行
        iif "lo" accept
        ct state established,related accept

        # 完全静默：不回 ICMP（减扫描发现面）
        ip protocol icmp drop
        ip6 nexthdr icmpv6 drop

        # 业务 UDP：单 IP 限速（每 10 秒 40 包；正常 ping/打洞信令远低于此）
        udp dport @protected_udp ct state new counter hashlimit \
            name wgp-udp \
            above 40/10sec burst 20 packets \
            drop
        udp dport @protected_udp accept

        # 信令 TCP 兜底：单 IP 并发/新建限速（正常一连接一请求，低频）
        tcp dport @protected_tcp ct state new counter limit rate over 20/second \
            drop
        tcp dport @protected_tcp accept

        # 其余全拒
        counter drop
    }
}
