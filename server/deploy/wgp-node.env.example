# ============================================================
# wgp-node 环境变量模板（systemd EnvironmentFile）
# 用法：sudo cp wgp-node.env.example /etc/wgp-node/env
#       按需取消注释 → systemctl restart wgp-node-hobby
#
# 键名与 server/wgp-node/src/server.rs collect_env() 一一对应
# （去 WGP_ 前缀后小写归一，与 wgp-node.conf 同一套解析）。
# 不设置 = 用二进制内置默认值（07 §6 规格：bind 0.0.0.0:11010
# + stun 3478 + tcp 3481，观察者限频 60/10s）。
# 优先级：命令行 > WGP_* 环境变量 > wgp-node.conf > 内置默认值
# ============================================================

# DHT 信令 UDP 绑定地址（SocketAddr 形态）
#WGP_BIND=0.0.0.0:11010

# 观察者/STUN 端口（none = 关闭）
#WGP_STUN=3478

# TCP 信令兜底端口（none = 关闭）
#WGP_TCP=3481

# 贡献模式（true = 拒绝 Forward 中转，PCDN 自保）
# 注意：wgp-node-hobby 二进制内部恒为 true 且不可关闭；
#       此键仅对完整版 wgp-node 有意义。
#WGP_HOBBY=true

# 观察者限频：每 IP 每窗口响应上限 / 窗口秒数
# 默认 60/10s（≈15 个成员并发协商，每次协商每端 4 次探测）
#WGP_OBSERVER_RATE_LIMIT=60
#WGP_OBSERVER_RATE_WINDOW=10

# 节点身份文件路径（默认 = 工作目录下 node_identity.key；勿删除）
#WGP_IDENTITY=/opt/wgp-node/node_identity.key

# 日志级别：error | warn | info | debug
#WGP_LOG_LEVEL=info

# 对外宣告的地址（不设 = 不宣告）。可写：
#   1) 固定公网 IPv4（VPS / 公网直连）
#   2) DDNS 域名（家宽动态 IP）：启动时解析，之后按 WGP_DDNS_REFRESH 重解析，
#      地址变化会自动换纪元重新宣告，不需要重启
#   3) none（不宣告）
#WGP_ADVERTISE=203.0.113.7
#WGP_ADVERTISE=seed.example.com
#WGP_DDNS_REFRESH=300

# 外部端口（0 = 沿用本机端口）。常见于「路由器换了外部端口」或 FRP 中继：
# 外部端口与本机端口不一致时**必须**显式给出，否则别人连的是错的端口。
#WGP_ADVERTISE_DHT_PORT=11010
#WGP_ADVERTISE_STUN_PORT=3478
#WGP_ADVERTISE_TCP_PORT=3481

# 接受回环/私网端点（局域网、本机联调、FRP 落在内网时用）。
# 默认只收公网地址：内网地址的种子广告会被丢弃（审计 M2）。
#WGP_ALLOW_LOCAL_ENDPOINTS=false

# 前置代理（FRP / nginx stream / 云 LB）注入 PROXY protocol v2 时打开（off | v2）。
# 打开后观察者与 TCP 信令用头里的**真实客户端地址**出映射报告与限速。
# 只能用于「本端口仅可信代理可访问」的部署；直接暴露公网时打开等于允许伪造来源。
#WGP_PROXY_PROTOCOL=off

# 入网引导：其他种子的 UDP 信令地址，逗号分隔（支持域名，启动时解析）
#WGP_PEERS=udp://seed-a.example:11010,udp://seed-b.example:11010
