# ============================================================
# wgp-node 环境变量模板（systemd EnvironmentFile）
# 用法：sudo cp wgp-node.env.example /etc/wgp-node/env
#       按需取消注释 → systemctl restart wgp-node-hobby
#
# 键名与 server/wgp-node/src/server.rs collect_env() 一一对应
# （去 WGP_ 前缀后小写归一，与 wgp-node.conf 同一套解析）。
# 不设置 = 用二进制内置默认值（07 §6 规格：bind 0.0.0.0:11010
# + stun 3478 + tcp 3481，观察者限频 12/10s）。
# 优先级：命令行 > WGP_* 环境变量 > wgp-node.conf > 内置默认值
# ============================================================

# DHT 信令 UDP 绑定地址（SocketAddr 形态）
#WGP_BIND=0.0.0.0:11010

# 观察者/STUN 端口（none = 关闭）
#WGP_STUN=3478

# TCP 信令兜底端口（none = 关闭）
#WGP_TCP=3481

# 贡献模式（true = 拒绝 Forward 中转，PCDN 自保）
# 注意：wgp-node-hobby 二进制内部恒为 true 且不可关闭；
#       此键仅对完整版 wgp-node 有意义。
#WGP_HOBBY=true

# 观察者限频：每 IP 每窗口响应上限 / 窗口秒数
#WGP_OBSERVER_RATE_LIMIT=12
#WGP_OBSERVER_RATE_WINDOW=10

# 节点身份文件路径（默认 = 工作目录下 node_identity.key；勿删除）
#WGP_IDENTITY=/opt/wgp-node/node_identity.key

# 日志级别：error | warn | info | debug
#WGP_LOG_LEVEL=info
